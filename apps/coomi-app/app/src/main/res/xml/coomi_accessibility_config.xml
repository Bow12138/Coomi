<?xml version="1.0" encoding="utf-8"?>
<!--
  CoomiDev accessibility service configuration.

  Capabilities:
  - performGlobalAction: back / home / recents / notifications
  - dispatchGesture:      tap, swipe, long-press at arbitrary coordinates
  - node introspection:   read the active window hierarchy (dump)
  - ACTION_ACCESSIBILITY broadcast: receives commands from the Coomi engine
    or a shell (am broadcast) so automation can be driven externally.

  The service is opt-in: the user must enable it in
  Settings > Accessibility > CoomiDev. It does not request any data
  collection and only acts on explicit commands.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/coomi_accessibility_description"
    android:notificationTimeout="100" />
